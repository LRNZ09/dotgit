# Core defaults and UI
[advice]
	skippedCherryPicks = false
	mergeConflict = false

[color]
	ui = auto

[column]
	ui = auto

[core]
	editor = code --wait
	excludesfile = ~/.gitignore

[help]
	autocorrect = prompt

[init]
	defaultBranch = main

# Branching, history, and commit flow
[branch]
	sort = -committerdate
	autoSetupMerge = simple

[tag]
	sort = version:refname

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	followTags = true

[fetch]
	prune = true
	pruneTags = true
	all = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
	committerDateIsAuthorDate = true

[rerere]
	enabled = true
	autoupdate = true

[commit]
	verbose = true

[user]
	email = 13508373+LRNZ09@users.noreply.github.com
	name = Lorenzo Pieri

# Diff and merge tooling
[diff]
	tool = default-difftool
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[difftool "default-difftool"]
	cmd = code --wait --diff $LOCAL $REMOTE

[merge]
	tool = default-mergetool

[mergetool "default-mergetool"]
	cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
	trustExitCode = false

[diff "lockb"]
	textconv = bun
	binary = true

# Credentials and host rewrites
[credential]
	gitLabAuthModes = pat
	helper = /usr/local/bin/git-credential-manager
	# credentialStore is OS-specific — see config-local

# GitHub HTTPS auth via gh's token. `!gh` (not an absolute path) keeps this
# portable — gh is on $PATH via Homebrew (macOS) and Linuxbrew. The empty
# `helper` first clears the inherited GCM helper so gh wins for this host.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://dev.azure.com"]
	useHttpPath = true

[credential "https://bitbucket.org"]
	provider = bitbucket

[url "https://bitbucket.org/"]
	insteadOf = ssh://git@bitbucket.org/

[url "git+https://bitbucket.org/"]
	insteadOf = git+ssh://git@bitbucket.org/

[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/

# Per-machine identity (signing key, etc.) — see config-local.example
[include]
	path = config-local

# Conditional includes
[includeIf "gitdir:~/Developer/work/"]
	path = config-work
